# Authentication & Secrets Configuration
SEO_ADMIN_EMAIL=admin@example.com
SEO_ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_key_here
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form (Resend)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=sales@ajumiai.com
CONTACT_FROM_EMAIL="Ajumi AI Website <noreply@ajumiai.com>"

# Website chatbot (free tiers; at least one key is needed for AI answers)
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini (fallback): https://aistudio.google.com/apikey
# Note: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
